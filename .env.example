# ---------------------------------------------------------------------------
# Connecteur MindGraphixSolution — variables du site client
#
# AUCUNE de ces variables ne doit être préfixée par NEXT_PUBLIC_ : le préfixe
# rend la valeur publique, elle est alors livrée dans le JavaScript du
# navigateur à tous les visiteurs. MGS_SITE_SECRET deviendrait lisible par
# n'importe qui, et la clé du site avec.
#
# Seules NEXT_PUBLIC_SUPABASE_URL et NEXT_PUBLIC_SUPABASE_ANON_KEY sont
# publiques : c'est le modèle normal de Supabase, la clé `anon` est protégée par
# les règles RLS.
# ---------------------------------------------------------------------------

# Plateforme qui détient les données de l'agence (obligatoire).
# Hors production, `http://localhost:3001` est accepté ; ailleurs, HTTPS exigé.
MGS_PLATFORM_URL=https://plateforme.example.com

# Identifiants du site, créés par `node scripts/create-site-credential.mjs`
# depuis le projet de la plateforme (obligatoires). Le secret n'est stocké que
# sous forme de hash : perdu, il faut en générer un nouveau.
MGS_SITE_KEY=remplir_depuis_la_plateforme
MGS_SITE_SECRET=remplir_depuis_la_plateforme

# Version du template, déclarée à la plateforme par `POST /api/agency/heartbeat`.
# Absente, le site déclare « 0.0.0 », ce qui se voit dans le tableau de bord de
# l'agence comme un site jamais déployé.
MGS_TEMPLATE_VERSION=1.0.0

# Durée de mise en cache des lectures authentifiées, en secondes (facultatif).
# 60 par défaut, 300 au maximum, 0 pour ne jamais cacher. Une modification faite
# dans le dashboard plateforme apparaît au pire après ce délai, et immédiatement
# si l'administrateur appelle `POST /api/agency/revalidate`.
MGS_CACHE_REVALIDATE_S=60

# Origine du site client, en toutes lettres (fortement recommandée).
# Elle sert au crédit du pied de page, au filet de repli « plateforme muette »,
# et surtout au contrôle d'origine de `POST /api/agency/revalidate` : sans elle,
# cet appel exige un en-tête `X-MGS-Revalidate` et ne peut pas être fait depuis
# un formulaire forgé.
MGS_WEBSITE_URL=https://votre-site-client.com

# Filet de sécurité affiché si la plateforme est injoignable (facultatif).
# Ce ne sont pas des coordonnées de remplacement : dès que la plateforme répond,
# c'est elle qui fait foi, même pour dire qu'elle n'a pas de numéro.
MGS_AGENCY_NAME=MindGraphixSolution
MGS_AGENCY_WHATSAPP=22670123456
MGS_AGENCY_EMAIL=contact@mindgraphixsolution.com

# POST /api/agency/request exige-t-il une session connectée ? (facultatif)
# Absente ou `1` : oui, c'est le défaut — l'email du demandeur est alors pris
# dans la session et jamais dans le corps de la requête. `0` seul rouvre le
# formulaire anonyme, et le corps devient la SEULE source de l'email : n'ouvrez
# cette porte que si le site a un formulaire de contact public voulu.
MGS_AGENCY_REQUIRER_SESSION=1

# Authentification du site client, fournie par la boutique elle-même.
NEXT_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=remplir